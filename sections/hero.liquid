<div class="flex">
  {% if section.settings.img1 %}
    <div class="w-full h-screen relative">
      <img 
        class="h-full w-full object-cover" 
        src="{{ section.settings.img1 | img_url: 'master' }}" 
        alt="Hero Image"
      >

      <!-- Overlay Content -->
      <div class="absolute bottom-20 left-20 text-white max-w-lg">
        <h1 class="text-4xl font-bold mb-4">
          {{ section.settings.head_title }}
        </h1>
        <h2 class="text-lg mb-6">
          {{ section.settings.discribtion }}
        </h2>
        <a 
          href="{{ section.settings.url }}" 
          class="bg-black/70 hover:bg-black text-white px-6 py-3 rounded-lg"
        >
          {{ section.settings.anker_title }}
        </a>
      </div>
    </div>
  {% endif %}

</div>


{% schema %}
{
  "name": "Hero",
  "settings": [

      {
        "type": "video",
        "id": "vid1",
        "label": "Video 1"
      },
      {
        "type": "video",
        "id": "vid2",
        "label": "Video 1"
      },
      {
        "type": "image_picker",
        "id": "img1",
        "label": "Image 1"
      },
      {
        "type": "image_picker",
        "id": "img2",
        "label": "Image 2"
      },
      {
        "type": "text",
        "id": "head_title",
        "default": "Welcome to Our Store",
        "label": "Heading Title"

      },
      {
        "type": "text",
        "id": "discribtion",
        "default":"This is our store have fun scrolling",
        "label": "Discribtion"
      },
      {
        "type": "text",
        "id": "anker_title",
        "default": "Shop Now",
        "label": "Anchor Title"
      },
      {
        "type": "url",
        "id": "url",
        "default": "/collections/all",
        "label": "URL"
      }
    
    ]
}
{% endschema %}