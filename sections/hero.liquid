<div class="relative w-full h-[700px]">
  {% if section.settings.hero_image != blank %}
    <img src="{{ section.settings.hero_image | img_url: 'master' }}" class="w-full h-full object-cover" alt="Hero Image">
    <div class="absolute inset-0 flex flex-col justify-center items-center text-center bg-black/40 px-4">
      <h1 class="text-white text-4xl font-bold mb-4">{{ section.settings.hero_heading }}</h1>
      <a class="bg-white text-black underline px-6 py-3" href="{{ section.settings.hero_link }}"> {{ section.settings.hero_button_text }} </a>
      
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "hero",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "hero_button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "url",
      "id": "hero_link",
      "label": "Hero Button Link",
      "default": "/collections/all"
    }

  ]
  
}
{% endschema %}
